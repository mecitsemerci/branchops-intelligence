# Copy to .env (git-ignored) to override docker compose defaults.
# BASE_IMAGE=python:3.12-slim
# PIP_INDEX_URL=https://pypi.org/simple
# JIRA_WEBHOOK_SECRETS=dev-secret
# POSTGRES_PORT=55432
# API_PORT=8080
# DASHBOARD_PORT=8090
# WORKER_HEALTH_PORT=8081
# WORKER_REPLICAS=1
#
# Real model endpoint instead of the mock provider:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://llm-gateway.bank.internal/v1
# LLM_MODEL=GLM-5.3-Flash
# LLM_API_KEY=...
