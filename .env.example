# Copy to .env (git-ignored) to override docker compose defaults. Every variable is optional for the
# local stack; the commented values are the defaults. In OpenShift the same names come from Secrets and
# ConfigMaps (deploy/openshift/), never from files in the image.
#
# Build
# IMAGE=branchops-intelligence:dev
# BASE_IMAGE=python:3.12-slim
# WHEELHOUSE_SOURCE=online                    # online (PIP_INDEX_URL) | offline (make wheelhouse)
# PIP_INDEX_URL=https://pypi.org/simple
# POSTGRES_IMAGE=postgres:17-alpine
#
# Secrets (development defaults; use real values outside a laptop)
# JIRA_WEBHOOK_SECRETS=dev-secret           # comma-separated HMAC secrets (rotation)
# JIRA_WEBHOOK_QUERY_TOKENS=                 # optional ?token= values for old Jira DC (never HMAC keys)
# DASHBOARD_STORAGE_SECRET=local-dev-storage-secret
# BRANCHOPS_PSEUDONYM_KEY=                   # HMAC key for pseudonymising host-app usernames (MCP reports)
# TICKETING_JIRA_TOKEN=                      # only with ticketing.sink: jira
# EMBEDDING_API_KEY=                         # only with workflow.similarity.embeddings.enabled
#
# Ports, scaling, logging
# POSTGRES_PORT=55432
# API_PORT=8080
# DASHBOARD_PORT=8090
# MCP_PORT=8095
# WORKER_REPLICAS=1
# WORKER_CONCURRENCY=1
# LOG_LEVEL=INFO
# DATABASE_URL=postgresql+psycopg://branchops:branchops@postgres:5432/branchops
#
# Jira custom fields (config/docker.yaml field_mapping)
# JIRA_FIELD_BRANCH_CODE=customfield_10101
# JIRA_FIELD_APPLICATION=customfield_10102
#
# Simulated Jira traffic
# SIMULATOR_INTERVAL_SECONDS=300
# SIMULATOR_INITIAL_BURST=2
# SIMULATOR_FOLLOW_UP_PROBABILITY=0.35
#
# Model server: vLLM in compose (make up; LLM_MODE=docker|host|mock, VLLM_DEVICE=cpu|gpu, HOST_LLM_PORT=8000
# are make variables: pass them on the make command line)
# VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct      # any Hugging Face model id vLLM supports
# VLLM_IMAGE=vllm/vllm-openai-cpu:v0.31.0     # CPU build (amd64/arm64)
# VLLM_GPU_IMAGE=vllm/vllm-openai:v0.31.0     # CUDA build (VLLM_DEVICE=gpu)
# VLLM_MAX_MODEL_LEN=16384                    # keep equal to llm.capabilities.context_length
# VLLM_DTYPE=bfloat16
# VLLM_CPU_KVCACHE_SPACE=1                    # GiB, CPU build
# VLLM_GPU_MEMORY_UTILIZATION=0.85            # GPU build
# VLLM_PORT=8099                              # published on 127.0.0.1 (container port 8000)
# HF_TOKEN=                                   # only for gated models
# HF_HUB_OFFLINE=1                            # after the first download: never contact the Hub
#
# Model as seen by the app (the Makefile's LLM_MODE sets the first two for you)
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct        # defaults to VLLM_MODEL; set it for LLM_MODE=host
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=300
# LLM_CA_BUNDLE=                              # internal CA bundle path for a TLS gateway
