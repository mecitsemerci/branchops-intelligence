# Copy to .env (git-ignored) to override docker compose defaults.
# BASE_IMAGE=python:3.12-slim
# PIP_INDEX_URL=https://pypi.org/simple
# JIRA_WEBHOOK_SECRETS=dev-secret
# POSTGRES_PORT=55432
# API_PORT=8080
# DASHBOARD_PORT=8090
# WORKER_REPLICAS=1
#
# Simulated Jira traffic
# SIMULATOR_INTERVAL_SECONDS=300
# SIMULATOR_INITIAL_BURST=2
# SIMULATOR_FOLLOW_UP_PROBABILITY=0.35
#
# Model (the Makefile's LLM_MODE=host|docker|mock sets these for you)
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=branchops-gemma3:4b
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=300
